// Cortex Hub - PostgreSQL Database Schema v3.0
// SRS v3.0 Section 8.2 — Merged models, integer money, workspace tenancy
//
// CHANGES FROM v2.0 (G12 FIX + SRS v3.0 Section 8.2):
// - Tenant renamed to Workspace (type BUYER | SELLER | PLATFORM)
// - Component folded into Product + ProductVersion (no more dual model)
// - License folded into Entitlement (unified access model)
// - Money stored as Int (minor units, e.g. cents/paise) — never Float
// - Added: Membership, Session, Invite, Price, Subscription, Invoice
//   Payment, Refund, UsageEvent, WalletLedger, SandboxRun, EvalResult,
//   ScanReport, AuditLog, Notification, Webhook
// - Every tenant-owned table has workspaceId + index for RLS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum WorkspaceType {
  BUYER
  SELLER
  PLATFORM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
  VIEWER
}

enum UserRole {
  VISITOR
  BUYER
  SELLER
  MODERATOR
  SUPPORT
  FINANCE
  ADMIN
  SUPERADMIN
}

enum VerificationLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  PLATFORM_REVIEWED
  VERIFIED
  ENTERPRISE_READY
}

enum ProductType {
  APPLICATION
  AI_AGENT
  API
  RAG_SYSTEM
  MODEL
  LORA
  EMBEDDING_MODEL
  RERANKER
  MCP_SERVER
  PYTHON_PACKAGE
  NPM_PACKAGE
  WORKFLOW
  DATASET
  CUSTOM_SERVICE
  PROMPT_PACK
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  HELD
}

enum ScanStatus {
  QUEUED
  RUNNING
  PASS
  FAIL
  ERROR
}

// ============================================================================
// 1. IDENTITY & WORKSPACES (SRS v3.0 Section 5.1, 8.2)
// G12 FIX: Tenant → Workspace (unified tenancy model)
// ============================================================================

/// Workspace is the unit of tenancy and billing (buyer org or seller org).
/// Replaces the old Tenant model.
model Workspace {
  id        String        @id @default(uuid())
  type      WorkspaceType
  name      String
  slug      String        @unique
  plan      String        @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  logoUrl   String?
  website   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members       Membership[]
  invites       Invite[]
  products      Product[] // seller workspaces list their products here
  orders        Order[] // buyer workspaces track orders here
  apiKeys       WorkspaceApiKey[]
  usageEvents   UsageEvent[]
  wallet        WalletLedger[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  notifications Notification[]
  webhooks      Webhook[]

  @@index([type])
  @@map("workspaces")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String? // null for OAuth-only users
  name          String
  avatarUrl     String?
  globalRole    UserRole @default(BUYER)
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  reviews     Review[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Membership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique // SHA-256 of the session token
  expiresAt  DateTime
  deviceInfo String? // user-agent summary
  ipAddress  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Invite {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime // 7 days per SRS AUTH-06
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invites")
}

// ============================================================================
// 2. SELLER PROFILE (SRS v3.0 Section 22)
// ============================================================================

model SellerProfile {
  id              String            @id @default(uuid())
  workspaceId     String            @unique
  handle          String            @unique
  displayName     String
  bio             String?
  organization    String?
  website         String?
  github          String?
  verifiedLevel   VerificationLevel @default(UNVERIFIED)
  kycPassed       Boolean           @default(false)
  averageRating   Float             @default(5.0)
  totalSalesCount Int               @default(0)
  responseTime    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  products Product[]

  @@map("seller_profiles")
}

// ============================================================================
// 3. PRODUCTS & VERSIONS (SRS v3.0 Section 8.2, 9)
// G12 FIX: Component + Product merged into Product + ProductVersion
// ============================================================================

model Product {
  id                 String            @id @default(uuid())
  workspaceId        String // seller workspace
  sellerId           String
  name               String
  slug               String            @unique
  shortDesc          String
  longDesc           String
  businessCategory   String? // business outcome category (SRS 8.1)
  technicalCategory  String? // tech taxonomy (SRS 8.2)
  productType        ProductType       @default(RAG_SYSTEM)
  status             ProductStatus     @default(DRAFT)
  verificationStatus VerificationLevel @default(UNVERIFIED)
  licenseType        String            @default("Commercial Permissive")
  tags               String[]
  features           String[]
  channels           String[] // Website, WhatsApp, Slack, etc.
  setupComplexity    String? // "Instant (<5 min)", "Easy (<15 min)"
  prerequisites      String? // plain-English prerequisites for buyers
  hardwareReqs       Json?
  benchmarks         Json?
  architecture       Json?
  codeSnippets       Json?
  // Live telemetry (PDP-02) — updated by platform, never seller-typed
  uptimePct30d       Float?
  latencyP95Ms       Float?
  evalScore          Float?
  activeInstalls     Int               @default(0)
  lastVersionDate    DateTime?
  // Commerce
  rating             Float             @default(5.0)
  ratingCount        Int               @default(0)
  downloadCount      Int               @default(0)
  viewCount          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id])
  seller       SellerProfile      @relation(fields: [sellerId], references: [id])
  versions     ProductVersion[]
  prices       Price[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  reviews      Review[]
  moderations  ModerationRecord[]
  evalResults  EvalResult[]
  scanReports  ScanReport[]
  sandboxRuns  SandboxRun[]

  @@index([workspaceId])
  @@index([status])
  @@index([productType])
  @@map("products")
}

model ProductVersion {
  id            String   @id @default(uuid())
  productId     String
  version       String // semver e.g. "2.4.1"
  changelog     String
  releaseNotes  String?
  artifactHash  String? // SHA-256 of primary artifact
  compatibility String? // "Python >=3.10, PyTorch 2.4"
  isLatest      Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductFile[]

  @@index([productId])
  @@map("product_versions")
}

model ProductFile {
  id             String   @id @default(uuid())
  versionId      String
  fileName       String
  storageKey     String // S3/object-storage path
  fileSize       BigInt // bytes
  checksumSha256 String
  mimeType       String
  createdAt      DateTime @default(now())

  version ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("product_files")
}

// ============================================================================
// 4. PRICING (SRS v3.0 Section 5.5 BILL-01)
// Supports: one-time, subscription, per-seat, pay-per-event, credits, free
// ============================================================================

model Price {
  id          String   @id @default(uuid())
  productId   String
  name        String // "Starter", "Pro", "Enterprise"
  model       String // ONE_TIME | SUBSCRIPTION | PER_SEAT | PER_EVENT | PER_TOKEN | CREDITS | FREE | CUSTOM
  amountMinor Int // integer minor units (cents/paise) — NEVER Float
  currency    String   @default("USD") // ISO 4217
  interval    String? // MONTH | YEAR (for subscriptions)
  unitLabel   String? // "per request", "per token", "per seat"
  freeUnits   Int? // free tier included units
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([productId])
  @@map("prices")
}

// ============================================================================
// 5. ORDERS, PAYMENTS, ENTITLEMENTS (SRS v3.0 Section 5.5)
// Money: always Int minor units + String currency (never Float)
// G4 FIX: Orders & entitlements now persist in Postgres, not memory
// ============================================================================

model Order {
  id               String      @id @default(uuid())
  workspaceId      String // buyer workspace
  buyerUserId      String
  totalAmountMinor Int // e.g. 4999 = $49.99
  taxAmountMinor   Int         @default(0)
  platformFeeMinor Int         @default(0)
  sellerNetMinor   Int         @default(0)
  currency         String      @default("USD")
  status           OrderStatus @default(CREATED)
  paymentProvider  String? // razorpay | stripe
  providerOrderId  String? // provider's order/payment-intent ID
  idempotencyKey   String?     @unique // Idempotency-Key header (SRS 8.3)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  entitlements Entitlement[]
  invoice      Invoice?

  @@index([workspaceId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  priceId     String
  licenseTier String
  amountMinor Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  price   Price   @relation(fields: [priceId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String
  amountMinor   Int
  currency      String    @default("USD")
  provider      String // razorpay | stripe
  providerPayId String?   @unique
  status        String    @default("PENDING")
  capturedAt    DateTime?
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  amountMinor      Int
  currency         String   @default("USD")
  reason           String?
  providerRefundId String?
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

/// G12 FIX: License model merged into Entitlement (unified access record).
/// License keys generated with CSPRNG (G2 FIX), stored as hash server-side.
model Entitlement {
  id               String    @id @default(uuid())
  workspaceId      String // buyer workspace
  productId        String
  orderId          String
  versionId        String?
  licenseKeyHash   String    @unique // SHA-256 of the key — raw key shown once, never stored
  licenseKeyPrefix String? // first characters only, so buyers can recognise the key
  licenseTier      String
  downloadAllowed  Boolean   @default(true)
  apiAccess        Boolean   @default(false)
  apiQuota         Int       @default(0) // requests/month; 0 = unlimited
  apiUsed          Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([workspaceId])
  @@index([productId])
  @@map("entitlements")
}

model Subscription {
  id                 String   @id @default(uuid())
  workspaceId        String
  productId          String
  priceId            String
  status             String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELED
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  providerSubId      String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  price Price @relation(fields: [priceId], references: [id])

  @@index([workspaceId])
  @@map("subscriptions")
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  workspaceId   String
  invoiceNumber String   @unique
  amountMinor   Int
  taxMinor      Int      @default(0)
  currency      String   @default("USD")
  gstNumber     String? // for Indian GST invoices
  hsnSacCode    String?
  storageKey    String? // PDF in object storage
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([workspaceId])
  @@map("invoices")
}

// ============================================================================
// 6. USAGE METERING (SRS v3.0 Section 5.5 BILL-04)
// Idempotency key prevents double-counting in replay tests
// ============================================================================

model UsageEvent {
  id             String   @id @default(uuid())
  workspaceId    String
  productId      String?
  apiKeyId       String?
  idempotencyKey String   @unique // prevents double-counting
  eventType      String // API_CALL | TOKEN | SANDBOX_RUN | DOWNLOAD
  units          Int      @default(1)
  amountMinor    Int      @default(0) // billable amount
  currency       String   @default("USD")
  recordedAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([recordedAt])
  @@map("usage_events")
}

// ============================================================================
// 7. API KEYS (SRS v3.0 Section 5.7 BUY-02)
// G2 FIX: Keys from CSPRNG, stored as SHA-256 hash, shown once
// ============================================================================

model WorkspaceApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  prefix      String // "ctx_live_abc123..." — safe to display
  keyHash     String    @unique // SHA-256 of full key — raw key never stored
  scopes      String[] // product IDs or "*" for all
  environment String    @default("production")
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_api_keys")
}

// ============================================================================
// 8. SELLER WALLET & PAYOUTS (SRS v3.0 Section 20)
// WalletLedger is double-entry bookkeeping
// ============================================================================

model WalletLedger {
  id          String   @id @default(uuid())
  workspaceId String
  type        String // SALE | FEE | REFUND | PAYOUT | ADJUSTMENT
  amountMinor Int // positive = credit, negative = debit
  currency    String   @default("USD")
  reference   String? // order ID, payout ID etc.
  note        String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([createdAt])
  @@map("wallet_ledger")
}

model Payout {
  id                 String       @id @default(uuid())
  workspaceId        String
  amountMinor        Int
  currency           String       @default("USD")
  method             String // stripe_connect | razorpay | bank_transfer
  destinationAccount String?
  status             PayoutStatus @default(PENDING)
  providerPayoutId   String?
  heldUntil          DateTime?
  processedAt        DateTime?
  createdAt          DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("payouts")
}

// ============================================================================
// 9. REVIEWS (SRS v3.0 Section 21)
// Only verified purchasers (entitlement >= 7 days old) may review
// ============================================================================

model Review {
  id               String    @id @default(uuid())
  productId        String
  reviewerId       String
  rating           Int // 1-5
  title            String
  comment          String
  versionPurchased String?
  useCase          String?
  verifiedPurchase Boolean   @default(false) // set true after entitlement check
  sellerReply      String?
  sellerRepliedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@unique([productId, reviewerId]) // prevent duplicate reviews
  @@index([productId])
  @@map("reviews")
}

// ============================================================================
// 10. TRUST & VERIFICATION (SRS v3.0 Section 5.9)
// ============================================================================

model ModerationRecord {
  id          String   @id @default(uuid())
  productId   String
  moderatorId String?
  action      String // SUBMIT | APPROVE | REJECT | SUSPEND | RESTORE | TAKEDOWN
  reason      String?
  checklist   Json?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("moderation_records")
}

model ScanReport {
  id           String     @id @default(uuid())
  productId    String
  versionId    String?
  status       ScanStatus @default(QUEUED)
  malwareScan  String?
  sbom         Json?
  cveScan      Json?
  licenseCheck String?
  score        Float?
  scannedAt    DateTime?
  createdAt    DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("scan_reports")
}

model EvalResult {
  id        String   @id @default(uuid())
  productId String
  versionId String?
  testSetId String
  score     Float // 0.0 - 1.0
  metrics   Json?
  runAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("eval_results")
}

// ============================================================================
// 11. SANDBOX RUNS (SRS v3.0 Section 5.4)
// ============================================================================

model SandboxRun {
  id            String    @id @default(uuid())
  productId     String
  sessionToken  String // SHA-256 of user id or client IP, for daily quotas
  userId        String?
  workspaceId   String?
  durationMs    Int?
  tokenCount    Int?
  costMinor     Int? // billable cost in minor units
  currency      String    @default("USD")
  status        String    @default("COMPLETED")
  inputPurgedAt DateTime? // SBX-05: purge within 24h
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([sessionToken, createdAt])
  @@map("sandbox_runs")
}

// ============================================================================
// 12. SUPPORT & CUSTOM IMPLEMENTATION (SRS v3.0 Section 5.10, 5.11)
// ============================================================================

model SupportTicket {
  id          String    @id @default(uuid())
  workspaceId String
  subject     String
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("OPEN")
  messages    Json
  slaDeadline DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@map("support_tickets")
}

model CustomizationRequest {
  id            String   @id @default(uuid())
  workspaceId   String
  productId     String?
  briefDoc      Json? // versioned brief document
  estimateMinor Int? // estimate in minor units
  currency      String   @default("USD")
  status        String   @default("DRAFT")
  timelineLog   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
  @@map("customization_requests")
}

// ============================================================================
// 13. AUDIT LOGS (SRS v3.0 NFR-AUD-01 — retained 7 years)
// ============================================================================

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  actorId     String?
  action      String // e.g. "order.created", "apikey.revoked"
  resourceId  String?
  before      Json? // state before change
  after       Json? // state after change
  ipAddress   String?
  requestId   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// 13b. PLATFORM SETTINGS (admin-configurable values such as the commission rate)
// ============================================================================

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================================
// 14. NOTIFICATIONS & WEBHOOKS (SRS v3.0 Section 5.11 ADM-06)
// ============================================================================

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  type        String // usage_threshold | version_released | review_received
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("notifications")
}

model Webhook {
  id          String    @id @default(uuid())
  workspaceId String
  url         String
  events      String[] // ["order.paid", "usage.threshold"]
  secretHash  String // HMAC secret stored as hash
  isActive    Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhooks")
}

// ============================================================================
// BACKWARD COMPATIBILITY SHIMS
// These models are kept temporarily to avoid breaking existing seed data and API
// routes that still reference the old Tenant/Component/License schema.
// They will be removed in Phase 1 after full migration.
// TODO Phase 0: migrate all routes from Tenant → Workspace, Component → Product,
//               License → Entitlement, and remove these models.
// ============================================================================

/// @deprecated Use Workspace instead. Kept for backward compatibility.
model Tenant {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  tier              String   @default("ENTERPRISE TIER")
  role              String   @default("ADMIN_SECURITY_OFFICER")
  monthlyTokenQuota BigInt   @default(10000000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  licenses              LegacyLicense[]
  apiKeys               LegacyApiKey[]
  customizationRequests LegacyCustomizationRequest[]
  supportTickets        LegacySupportTicket[]
  usageMetrics          LegacyUsageMetric[]

  @@map("tenants")
}

/// @deprecated Use Product instead.
model Component {
  id                String   @id
  name              String
  category          String
  categoryBadge     String   @default("badge-indigo")
  version           String   @default("v1.0.0")
  shortDesc         String
  longDesc          String
  coreOutput        String
  targetBuyer       String
  basePrice         Int
  priceFormatted    String
  inrPriceFormatted String
  tags              String[]
  features          String[]
  pricingTiers      Json
  architecture      Json
  codeSnippets      Json
  published         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  licenses       LegacyLicense[]
  customRequests LegacyCustomizationRequest[]

  @@map("components")
}

/// @deprecated Use Entitlement instead.
model LegacyLicense {
  id            String    @id @default(uuid())
  tenantId      String
  componentId   String
  tier          String
  licenseKey    String    @unique
  status        String    @default("ACTIVE")
  clusterTarget String    @default("Dedicated VPC (AWS us-east-1)")
