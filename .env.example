# =============================================================================
# Cortex Hub — Environment Configuration
# SRS v3.0 (Oct 31, 2026) — Phase 0 required variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# G9 FIX: Used by clients for API URL (set to actual deployment domain in prod)
# Server-rendered pages should inject this as window.CORTEX_API_URL
API_BASE_URL=http://localhost:5000/api

# G3 FIX: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16+)
# SRS v3.0 S8.1: PostgreSQL with pgvector and row-level security
# -----------------------------------------------------------------------------
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cortex_hub"
# Cloud (Neon / Supabase / RDS):
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (SRS v3.0 S5.1 AUTH-01)
# Phase 0: placeholder — replace with Better Auth or Auth.js
# -----------------------------------------------------------------------------
JWT_SECRET="replace-with-at-least-64-random-chars-generated-by-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_COOKIE_SECRET="replace-with-at-least-32-random-chars"

# OAuth (AUTH-01: Google and GitHub OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Enterprise SSO (AUTH-04: SAML/SCIM — Phase 1)
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# -----------------------------------------------------------------------------
# Payments (SRS v3.0 S4.4 — Phase 1)
# G5 FIX: Real payment providers (not simulated)
# -----------------------------------------------------------------------------
# Razorpay (India — INR, UPI, cards, netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Connect (Global — USD, EUR, SEPA, ACH)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Object Storage (SRS v3.0 S8.1 — model weights, packages, invoices)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3          # s3 | gcs | r2
S3_BUCKET=cortex-hub-artifacts
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For signed URL expiry (seconds):
S3_SIGNED_URL_EXPIRY=900      # 15 minutes per SRS RUN-02

# -----------------------------------------------------------------------------
# Email (SRS v3.0 S8.1 — invites, invoices, notifications)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend          # resend | ses
RESEND_API_KEY=
FROM_EMAIL=noreply@cortex-hub.io

# -----------------------------------------------------------------------------
# Search (SRS v3.0 S8.1 DISC-02 — hybrid keyword+vector)
# Phase 0: Postgres full-text + pgvector. Phase 1: Typesense when >5k listings
# -----------------------------------------------------------------------------
# TYPESENSE_HOST=
# TYPESENSE_API_KEY=
# TYPESENSE_COLLECTION=listings

# -----------------------------------------------------------------------------
# Cache & Queues (SRS v3.0 S8.1 — Phase 1)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Observability (SRS v3.0 NFR-OBS-01)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=cortex-hub-api
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# AI Safety (SRS v3.0 NFR-AI-01 — sandbox LLM guardrails)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# -----------------------------------------------------------------------------
# Platform Configuration
# -----------------------------------------------------------------------------
# Default platform commission rate (SRS S19 — configurable by admin)
PLATFORM_COMMISSION_RATE=0.15   # 15%

# Sandbox limits (SRS SBX-04)
SANDBOX_FREE_RUNS_VISITOR=20
SANDBOX_FREE_RUNS_SIGNED_IN=100

# Payout minimum (seller must exceed this to withdraw)
PAYOUT_MINIMUM_USD_CENTS=5000   # $50.00
