# =============================================================================
# Cortex Hub — Environment Configuration
# SRS v3.0 (Oct 31, 2026) — Phase 0 required variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# G9 FIX: The Express server serves the frontend and the API from one origin,
# so the browser calls same-origin /api and no API URL is configured here.

# G3 FIX: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16+)
# SRS v3.0 S8.1: PostgreSQL with pgvector and row-level security
# -----------------------------------------------------------------------------
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cortex_hub"
# Cloud (Neon / Supabase / RDS):
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (SRS v3.0 S5.1 AUTH-01..05)
# Sessions are random tokens stored hashed in the sessions table (HttpOnly,
# SameSite=Lax cookie, Secure when NODE_ENV=production); no signing secret needed.
# -----------------------------------------------------------------------------
# Password for the demo accounts created by `npm run db:seed`
# (buyer@acme-health.test, seller@apex-ai.test, admin@cortex-hub.test).
# Leave empty to have the seed generate one and print it once.
SEED_DEMO_PASSWORD=

# OAuth (AUTH-01: Google and GitHub OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Enterprise SSO (AUTH-04: SAML/SCIM — Phase 1)
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# -----------------------------------------------------------------------------
# Payments (SRS BILL-02)
# -----------------------------------------------------------------------------
# Razorpay (India: INR, UPI, cards, netbanking). Checkout settles in INR + 18% GST.
# Without these keys, checkout runs a clearly labelled simulated payment when
# NODE_ENV is not "production"; in production it is refused.
# Webhook URL to register in the Razorpay dashboard: https://<your-domain>/api/webhooks/razorpay
# (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional SAC code printed on GST invoices
INVOICE_SAC_CODE=

# Stripe Connect (Global: USD, EUR, SEPA, ACH) - not wired up yet
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Object Storage (SRS v3.0 S8.1 — model weights, packages, invoices)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3          # s3 | gcs | r2
S3_BUCKET=cortex-hub-artifacts
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For signed URL expiry (seconds):
S3_SIGNED_URL_EXPIRY=900      # 15 minutes per SRS RUN-02

# -----------------------------------------------------------------------------
# Email (SRS v3.0 S8.1 — invites, invoices, notifications)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend          # resend | ses
RESEND_API_KEY=
FROM_EMAIL=noreply@cortex-hub.io

# -----------------------------------------------------------------------------
# Twilio (SMS OTP, Phone Verification & WhatsApp AI Assistant — SRS §2.3, ADM-06)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# -----------------------------------------------------------------------------
# Search (SRS v3.0 S8.1 DISC-02 — hybrid keyword+vector)
# Phase 0: Postgres full-text + pgvector. Phase 1: Typesense when >5k listings
# -----------------------------------------------------------------------------
# TYPESENSE_HOST=
# TYPESENSE_API_KEY=
# TYPESENSE_COLLECTION=listings

# -----------------------------------------------------------------------------
# Cache & Queues (SRS v3.0 S8.1 — Phase 1)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Observability (SRS v3.0 NFR-OBS-01)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=cortex-hub-api
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# Live sandbox (SRS SBX-01..05): answers questions about documents with Claude.
# Without a key the sandbox shows recorded sample answers, labelled as such.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for sandbox runs (default claude-opus-5-5)
# SANDBOX_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# -----------------------------------------------------------------------------
# Platform Configuration
# -----------------------------------------------------------------------------
# Default platform commission until an admin saves one in the console (SRS S19)
PLATFORM_COMMISSION_RATE=0.15

# Sandbox limits (SRS SBX-04)
SANDBOX_FREE_RUNS_VISITOR=20
SANDBOX_FREE_RUNS_SIGNED_IN=100

# Minimum seller payout, in paise (50000 = ₹500)
PAYOUT_MINIMUM_INR_PAISE=50000
