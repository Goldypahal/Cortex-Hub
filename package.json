{
  "name": "cortex-hub",
  "version": "3.0.0",
  "type": "module",
  "description": "Cortex Hub — AI/ML Marketplace & Commercialization Platform (SRS v3.0)",
  "main": "index.html",
  "scripts": {
    "dev": "npx -y serve . -l 3000",
    "start": "npx -y serve . -l 3000",
    "server": "node server/server.js",
    "fullstack": "concurrently \"npm run server\" \"npm run dev\"",

    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "db:studio": "prisma studio --schema=server/prisma/schema.prisma",
    "db:format": "prisma format --schema=server/prisma/schema.prisma",

    "lint": "eslint js/**/*.js server/**/*.js --max-warnings 0",
    "lint:fix": "eslint js/**/*.js server/**/*.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"server/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"server/**/*.js\" \"css/**/*.css\"",

    "validate": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "marketplace",
    "rag",
    "mcp",
    "customization",
    "saas",
    "postgresql",
    "prisma"
  ],
  "author": "Cortex Hub Platform Team",
  "license": "MIT"
}
