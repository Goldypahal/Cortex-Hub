{
  "name": "cortex-hub",
  "version": "3.0.0",
  "type": "module",
  "description": "Cortex Hub — AI/ML Marketplace & Commercialization Platform (SRS v3.0)",
  "main": "index.html",
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "fullstack": "node server/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "db:studio": "prisma studio --schema=server/prisma/schema.prisma",
    "db:format": "prisma format --schema=server/prisma/schema.prisma",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"server/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"server/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\"",
    "validate": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.3.3",
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "marketplace",
    "rag",
    "mcp",
    "customization",
    "saas",
    "postgresql",
    "prisma"
  ],
  "author": "Cortex Hub Platform Team",
  "license": "MIT"
}
